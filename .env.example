# Copy to .env (which git ignores) and adjust if needed: cp .env.example .env
# Commands load it with: uv run --env-file .env ...   (scripts/check.sh loads it automatically)
# After creating or changing .env, set up the database once:
#   uv run --env-file .env python -m fish_server.deploy

# The database as its owner: migrations and admin tools. Matches infra/docker-compose.yml.
FISH_ADMIN_DATABASE_URL=postgresql+psycopg://fish:fish_dev@127.0.0.1:55432/fish

# Password of the fish_server login the running server uses (16+ characters). Local only;
# on Render this is generated and never seen.
FISH_APP_DB_PASSWORD=local-dev-app-password-0001

# A database on the same server that tests may connect to in order to create and drop
# throwaway databases. Leave unset to skip the database tests.
FISH_TEST_DATABASE_URL=postgresql+psycopg://fish:fish_dev@127.0.0.1:55432/postgres
